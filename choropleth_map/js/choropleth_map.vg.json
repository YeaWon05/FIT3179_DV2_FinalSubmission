{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": 800,
    "height": 500,

    "projection": {
        "type": "mercator"
    },

    "layer": [
        {
            "data": {
                "url": "choropleth_map/js/australia_states.topojson",
                "format": {
                    "type": "topojson",
                    "feature": "ne_10m_admin_1_states_provinces"
                }
            },

            "transform": [
                {
                    "lookup": "properties.region",
                    "from": {
                        "data": {
                            "url": "choropleth_map/data/number_of_fishers.csv",
                            "format": {
                                "type": "csv"
                            }
                        },
                        "key": "State/territory",
                        "fields": [
                            "Participation rate"
                        ]
                    }
                }
            ],

            "mark": {
                "type": "geoshape",
                "stroke": "white",
                "strokeWidth": 1.5
            },

            "encoding": {
                "color": {
                    "field": "Participation rate",
                    "type": "quantitative",
                    "title": "Participation Rate (%)",
                    "scale": {
                        "scheme": "blues"
                    }
                },

                "tooltip": [
                    {
                        "field": "properties.region",
                        "type": "nominal",
                        "title": "State/Territory"
                    },
                    {
                        "field": "Participation rate",
                        "type": "quantitative",
                        "title": "Participation Rate (%)",
                        "format": ".2f"
                    }
                ]
            }
        },

        {
            "data": {
                "values": [
                    {"StateLabel": "WA", "Longitude": 121.0, "Latitude": -25.5},
                    {"StateLabel": "NT", "Longitude": 133.5, "Latitude": -19.0},
                    {"StateLabel": "SA", "Longitude": 135.5, "Latitude": -30.0},
                    {"StateLabel": "QLD", "Longitude": 145.5, "Latitude": -24.0},
                    {"StateLabel": "NSW/ACT", "Longitude": 147.0, "Latitude": -32.0},
                    {"StateLabel": "VIC", "Longitude": 144.5, "Latitude": -37},
                    {"StateLabel": "TAS", "Longitude": 146.5, "Latitude": -42.0}
                ]
            },

            "mark": {
                "type": "text",
                "fontSize": 13,
                "fontWeight": "bold",
                "color": "black",
                "stroke": "white",
                "strokeWidth": 0.5
            },

            "encoding": {
                "longitude": {
                    "field": "Longitude",
                    "type": "quantitative"
                },
                "latitude": {
                    "field": "Latitude",
                    "type": "quantitative"
                },
                "text": {
                    "field": "StateLabel",
                    "type": "nominal"
                }
            }
        }
    ]
}