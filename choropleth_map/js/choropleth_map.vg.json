{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": 800,
    "height": 500,

    "projection": {
        "type": "mercator"
    },

    "data": {
        "url": "choropleth_map/js/australia_states.topojson",
        "format": {
            "type": "topojson",
            "feature": "ne_10m_admin_1_states_provinces"
        }
    },

    "transform": [
        {
            "lookup": "properties.region",
            "from": {
                "data": {
                    "url": "choropleth_map/data/number_of_fishers.csv",
                    "format": {
                        "type": "csv"
                    }
                },
                "key": "State/territory",
                "fields": [
                    "Participation rate"
                ]
            }
        }
    ],

    "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
    },

    "encoding": {
        "color": {
            "field": "Participation rate",
            "type": "quantitative",
            "title": "Participation Rate (%)",
            "scale": {
                "scheme": "blues"
            }
        },

        "tooltip": [
            {
                "field": "properties.region",
                "type": "nominal",
                "title": "State/Territory"
            },
            {
                "field": "Participation rate",
                "type": "quantitative",
                "title": "Participation Rate (%)",
                "format": ".2f"
            }
        ]
    }
}