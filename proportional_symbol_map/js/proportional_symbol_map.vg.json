{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 600,
  "height": 650,

  "title": "Total Recreational Fishing Catch by Fishing Region in Queensland",

  "projection": {
    "type": "mercator",
    "scale": 1200,
    "center": [145, -20]
  },

  "layer": [

    {
      "data": {
        "url": "proportional_symbol_map/js/queensland.geojson"
      },

      "mark": {
        "type": "geoshape",
        "fill": "white",
        "stroke": "black",
        "strokeWidth": 0.7
      }
    },

    {
      "data": {
        "url": "proportional_symbol_map/data/queensland_fish.csv",
        "format": {
          "type": "csv"
        }
      },

      "mark": {
        "type": "circle",
        "opacity": 0.65,
        "stroke": "black",
        "strokeWidth": 0.8
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Total Catch",
          "type": "quantitative",
          "scale": {
            "range": [30, 1500]
          },
          "legend": {
            "title": "Total Catch"
          }
        },

        "tooltip": [
          {
            "field": "Fishing Region",
            "type": "nominal",
            "title": "Fishing Region"
          },
          {
            "field": "Total Catch",
            "type": "quantitative",
            "title": "Total Catch",
            "format": ","
          }
        ]
      }
    }
  ]
}