{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 400,

  "data": {
    "url": "bar_chart/data/reason_participation.csv",
    "format": {"type": "csv"}
  },

  "transform": [
    {"calculate": "trim(datum['Motivation'])", "as": "Reason"},
    {"calculate": "toNumber(trim(datum[' Total (%)'] || datum['Total (%)']))", "as": "Percent"},
    {
      "joinaggregate": [
        {"op": "max", "field": "Percent", "as": "Highest"},
        {"op": "min", "field": "Percent", "as": "Lowest"}
      ]
    },
    {
      "calculate": "datum.Percent === datum.Highest ? 'Highest' : datum.Percent === datum.Lowest ? 'Lowest' : 'Other'",
      "as": "Highlight"
    }
  ],

  "encoding": {
    "y": {
      "field": "Reason",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 13,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "Percent",
      "type": "quantitative",
      "title": "Share of respondents (%)",
      "scale": {"domain": [0, 40]},
      "axis": {
        "grid": true,
        "gridColor": "#eeeeee",
        "tickMinStep": 5
      }
    },
    "color": {
      "field": "Highlight",
      "type": "nominal",
      "scale": {
        "domain": ["Highest", "Lowest", "Other"],
        "range": ["#59a14f", "#FFA500", "#1f77b4"]
      },
      "legend": null
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "height": {"band": 0.7}
      },
      "encoding": {
        "tooltip": [
          {"field": "Reason", "type": "nominal", "title": "Motivation"},
          {"field": "Percent", "type": "quantitative", "title": "Share (%)"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "Percent",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],

  "config": {
    "view": {"stroke": null},
    "axis": {"grid": false}
  }
}